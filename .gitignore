# secrets and environments
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/scheduled_tasks.lock
.taste-skill/

# large or regenerable outputs
logs/
runs/
output/
*.pt

# data/: only experiment write-ups and tools and human labels are versioned
# (videos, scans, caches, embeddings and datasets are regenerated by the scripts)
data/**
!data/**/
!data/exp_*/*.md
!data/exp_*/tools/*.py
!data/exp_launch/prod_signals.py
!data/labels/*.json
# data/scouting/: 5026's scouting export stays local (not in the public repo)
