# Copy to .env (scripts/setup.py does this) and fill in what you need.

# The Blue Alliance API key: free, from https://www.thebluealliance.com/account (Read API Keys).
# Not needed to browse or re-analyse the 131 matches in the data pack (their TBA answers are cached);
# needed to process any other match.
TBA_API_KEY=

# Roboflow API key: only for rebuilding the detector training sets (scripts/merge_datasets.py and friends).
ROBOFLOW_API_KEY=
